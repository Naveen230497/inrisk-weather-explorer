# Storage: Leave R2_ENDPOINT_URL empty for local filesystem storage
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=weather-data

# CORS: Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# Local storage (only used when R2_ENDPOINT_URL is empty)
LOCAL_STORAGE_DIR=./data
